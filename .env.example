# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# API
PORT=4000

# Supabase Postgres via pooler.
# DATABASE_URL is used by the running app.
# DIRECT_URL is used by Prisma migrations.
# Replace [project-ref] and [YOUR-PASSWORD] with your real Supabase values.
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Supabase Storage/API.
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://[project-ref].supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_PUBLIC_BUCKET="toeic-assets"
